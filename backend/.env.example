MONGO_URI=mongodb://localhost:27017
DB_NAME=maapsetu

# development (default) or production. Setting this to "production" turns on
# hard startup guards: JWT_SECRET must be a real 32+ char secret,
# COOKIE_SECURE must be true, CORS_ALLOWED_ORIGINS must be set to a real
# frontend origin -- and the /__dev/db-info debug route is not mounted at all.
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Defaults to the Vite dev server origin. MUST be set to the real deployed
# frontend origin(s) in production -- never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to true once served over HTTPS (required if ENVIRONMENT=production) --
# otherwise the refresh-token cookie is dropped/insecure.
COOKIE_SECURE=false
# Refresh-token cookie SameSite policy: strict (default), lax or none.
# If the frontend (e.g. Vercel) and the API (e.g. Render) are on DIFFERENT
# sites, "strict"/"lax" cookies are never sent on the frontend's fetch calls,
# so token refresh and "Remember me" cannot work -- use COOKIE_SAMESITE=none
# (which requires COOKIE_SECURE=true / HTTPS).
COOKIE_SAMESITE=strict
# "Remember me": days the refresh cookie lasts when the box is ticked.
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_DAYS=30
# Forgot password: min seconds between two reset emails for one account.
PASSWORD_RESET_COOLDOWN_SECONDS=60
# Where READ-HEAVY, staleness-tolerant endpoints (geo, dashboards, public verify,
# audit-log viewer) read from: primary (default) or secondaryPreferred (use a replica-set
# secondary when available). Sign-in and other security-critical reads always use the
# primary. Don't also put readPreference in MONGO_URI.
MONGO_READ_PREFERENCE=primary
# Minimum seconds between two signup verification codes to the same address.
OTP_SEND_COOLDOWN_SECONDS=60
# Two-step verification (authenticator app) for officer/admin accounts.
# Key used to encrypt authenticator secrets at rest (any long random string,
# e.g. `openssl rand -hex 32`). If unset it is derived from JWT_SECRET -- set a
# dedicated value in production so rotating JWT_SECRET later doesn't make every
# stored authenticator undecryptable.
MFA_ENCRYPTION_KEY=
# How long the "password accepted, now enter your code" step stays valid.
MFA_TOKEN_EXPIRES_MINUTES=10
# Name shown in the authenticator app next to the account.
MFA_ISSUER=MaapSetu
# One-time recovery codes issued when an authenticator is set up.
MFA_RECOVERY_CODE_COUNT=8
# Days to keep the security audit log before MongoDB expires it
# (minimum 180 is enforced; CERT-In asks for at least 180 days).
AUDIT_LOG_RETENTION_DAYS=365
# Secret used to hash OTP / password-reset codes. REQUIRED in production --
# set to a long random string (e.g. `openssl rand -hex 32`); without it a
# well-known dev default is used.
OTP_PEPPER=

# Optional. When set, the DDoS-protection middleware stores its per-IP
# counters/blocks in Redis instead of an in-process dict, so state is shared
# correctly across `uvicorn --workers N` and across multiple deployed
# containers. Leave unset for local dev / a single-worker deployment.
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Use a long, random string in production -- e.g. `openssl rand -hex 32`.
# Never reuse the placeholder below outside of local dev; startup will
# refuse to run with this value when ENVIRONMENT=production.
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where officer credential emails link back to (the frontend's /login page).
FRONTEND_LOGIN_URL=http://localhost:5173/login

# SMTP, used for OTP codes, an admin-created officer's one-time temp password,
# and application/account status-update emails (app/services/mailer.py,
# app/services/status_emails.py). Optional -- if SMTP_HOST/SMTP_FROM
# are left blank, the app logs a warning and skips sending; the admin still
# sees the temp password once on screen as a fallback. Example values for
# Gmail SMTP (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.account@gmail.com
#   SMTP_PASSWORD=<app password>
#   SMTP_FROM=your.account@gmail.com
#   SMTP_USE_TLS=true

# Status-update emails (submitted / scheduled / certified / rejected /
# expiring / expired, certificate ready, officer account activated/suspended).
# Links in those emails point at FRONTEND_BASE_URL; if blank it is derived from
# FRONTEND_LOGIN_URL. Set STATUS_EMAILS_ENABLED=false to turn them all off.
FRONTEND_BASE_URL=http://localhost:5173
STATUS_EMAILS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Sender for OTP mails (signup + password reset). Use a no-reply address, e.g.
# MaapSetu <noreply@yourdomain.in>. Blank = SMTP_FROM's address shown as "MaapSetu (No-Reply)".
NOREPLY_FROM=
SMTP_USE_TLS=true
OWNER_EMAIL_NOTIFICATIONS_ENABLED=true
EXPIRY_REMINDER_DAYS=30,15,7,1

# Super-admin / Minister account — see seed_super_admin.py. Not used by the
# running app directly; only read once by that script to create/update the
# account. Set a strong, unique password here (this file itself, .env, is
# already gitignored — never commit real values).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Minister of Legal Metrology
# Brevo HTTP API (recommended on Render free tier, where SMTP ports are blocked).
# Set BREVO_API_KEY and SMTP_FROM (a sender verified in Brevo); SMTP_* is then ignored.
BREVO_API_KEY=
