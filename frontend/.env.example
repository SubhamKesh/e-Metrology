# Base URL of the MaapSetu API, without trailing slash.
# The API contract already prefixes routes with /api/v1, so point this at
# the server root, e.g. http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Public canonical origin of the deployed site (https, no path, no trailing slash). Used by the build's
# SEO prerender for canonical URLs, sitemap.xml and robots.txt. Optional for local builds (prerender is
# skipped); required on Render/Vercel/CI. Example: https://www.example.com
# VITE_SITE_URL=
