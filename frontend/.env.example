# Base URL of the MaapSetu API, without trailing slash.
# The API contract already prefixes routes with /api/v1, so point this at
# the server root, e.g. http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# REQUIRED for production builds (`npm run build` fails without it).
# Canonical public origin of the site: https, no path, no trailing slash.
# Used for canonical URLs, Open Graph URLs, sitemap.xml and robots.txt.
# Must not be localhost. A custom domain with your brand in it is strongly recommended;
# *.vercel.app works but prints a warning. In Vercel set it for Production (and Preview,
# if previews should build) under Settings -> Environment Variables.
VITE_SITE_URL=https://www.example.com

# Optional: Google Search Console "HTML tag" verification token (only the content value).
# When set, <meta name="google-site-verification" content="..."> is added to every generated page.
VITE_GSC_VERIFICATION=
